# Environment variables for Master Order
# Copy this to .env and customize with your values

# ===========================================
# DEVELOPMENT SETTINGS (for local dev)
# ===========================================
# DATABASE_URL=file:./master_order.db

# ===========================================
# PRODUCTION SETTINGS (for Docker/Unraid)
# ===========================================
# DATABASE_URL=file:/app/data/db/master_order.db

# Server Configuration
NODE_ENV=development
PORT=3001

# Plex Configuration
# PLEX_URL=http://your-plex-server:32400
# PLEX_TOKEN=your-plex-token-here

# API Keys
# TVDB_API_KEY=your-tvdb-api-key
# COMICVINE_API_KEY=your-comicvine-api-key

# Optional: Timezone (defaults to system timezone)
# TZ=America/New_York

# Optional: User/Group IDs for file permissions (Unraid defaults)
# PUID=99
# PGID=100

# ===========================================
# MEDIA PATH MAPPINGS (for metadata extraction)
# ===========================================
# Map Plex's internal paths to your actual file system paths
# Required for music metadata extraction to work properly

# Christmas Music (maps to /xmas in Plex)
# XMAS_PATH=C:\Media\Christmas

# Movies (maps to /movies in Plex)  
# MOVIES_PATH=C:\Media\Movies

# Music (maps to /music in Plex)
# MUSIC_PATH=C:\Media\Music

# Classical Music (maps to /classical in Plex)
# CLASSICAL_PATH=C:\Media\Classical

# TV Shows (maps to /tv in Plex)
# TV_PATH=C:\Media\TV

# Video Games (maps to /video_games in Plex)
# VIDEO_GAMES_PATH=C:\Media\VideoGames

# Pop Music (maps to /pop_music in Plex)
# POP_MUSIC_PATH=C:\Media\PopMusic

# Alternative: Single media root path (if all media is under one folder)
# MEDIA_PATH=C:\Media
# PGID=100
