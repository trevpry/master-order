# Import Configuration
# Copy this file to .env.import and fill in your hosted PostgreSQL credentials

# Hosted PostgreSQL Database (Source)
IMPORT_HOST=your-hosted-db-host.com
IMPORT_USER=your-username
IMPORT_PASSWORD=your-password
IMPORT_DATABASE=your-database-name
IMPORT_PORT=5432

# Full connection string format (alternative to individual settings)
# IMPORT_DATABASE_URL=postgresql://username:password@host:port/database

# Import Options
IMPORT_BATCH_SIZE=1000
IMPORT_TIMEOUT=300
IMPORT_SKIP_TABLES=temp_table1,temp_table2

# Local Development Target (if different from default)
LOCAL_DATABASE_URL=file:./master_order.db

# Production Target (if different from docker-compose.yml)
PRODUCTION_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/master_order

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Logging
LOG_LEVEL=info
LOG_FILE=import.log