# Master Order Environment Configuration
# Copy this file to .env and update with your values

# =======================
# DATABASE CONFIGURATION
# =======================

# For local development (SQLite)
DATABASE_URL=file:./master_order.db

# For production (PostgreSQL) - uncomment and configure:
# DATABASE_URL=postgresql://username:password@localhost:5432/master_order

# =======================
# SERVER CONFIGURATION  
# =======================

NODE_ENV=development
PORT=3001

# =======================
# PLEX CONFIGURATION
# =======================

# Plex server settings (optional)
# PLEX_URL=http://your-plex-server:32400
# PLEX_TOKEN=your-plex-token-here

# Path mappings for file metadata extraction
# Maps Plex internal paths to local filesystem paths
# Multiple mappings supported using numbered variables (1, 2, 3, etc.)
# 
# Development example (Windows):
# PLEX_PATH_1=/music
# LOCAL_PATH_1=D:\Music
# PLEX_PATH_2=/classical
# LOCAL_PATH_2=E:\ClassicalMusic
#
# Production/Docker example (paths usually match):
# PLEX_PATH_1=/music
# LOCAL_PATH_1=/music
#
# Leave empty if Plex paths match local paths (e.g., in Docker)

# =======================
# RADARR / SONARR CONFIGURATION (movie & TV library population)
# =======================
# See SONARR_RADARR_DIRECT_PLAY_MIGRATION_PLAN.md for the full migration plan.
# Leave unset to keep using Plex for library population (LIBRARY_PROVIDER=plex).

# RADARR_URL=http://your-radarr-server:7878
# RADARR_API_KEY=your-radarr-api-key
# SONARR_URL=http://your-sonarr-server:8989
# SONARR_API_KEY=your-sonarr-api-key

# Which system currently populates the movie/TV libraries: "plex" (default) or "arr"
# LIBRARY_PROVIDER=plex

# Generic remote->local path mappings, used for Radarr/Sonarr file paths in
# addition to Plex. Prefer REMOTE_PATH_n over the legacy PLEX_PATH_n name.
# Multiple mappings supported using numbered variables (1, 2, 3, etc.)
#
# REMOTE_PATH_1=/movies
# LOCAL_PATH_1=/movies
# REMOTE_PATH_2=/tv
# LOCAL_PATH_2=/tv

# =======================
# DIRECT-PLAY / TRANSCODING CONFIGURATION
# =======================
# ffmpeg/ffprobe binaries are auto-detected (system PATH, or the bundled
# ffmpeg-static / @ffprobe-installer/ffprobe npm packages as a dev fallback).
# Only set these if you need to point at a specific binary:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Directory used to write temporary HLS transcode segments
# TRANSCODE_TMP_DIR=/app/data/transcode

# Hardware acceleration for transcoding: none (default) | vaapi | nvenc
# HW_ACCEL=none

# =======================
# API KEYS
# =======================

# TVDB API Key (for non-Plex TV content)
# TVDB_API_KEY=your-tvdb-api-key

# ComicVine API Key (for comic metadata)
# COMICVINE_API_KEY=your-comicvine-api-key

# Gemini AI API Key (for AI categorization features)
# Get your API key from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# =======================
# NOTES
# =======================

# Database Schema Selection:
# - The application automatically detects your environment and uses:
#   * SQLite for local development (DATABASE_URL starts with "file:")
#   * PostgreSQL for production/Docker (DATABASE_URL starts with "postgresql://")
#
# Docker Configuration:
# - When running in Docker, PostgreSQL is automatically used
# - The docker-compose.yml file sets up a PostgreSQL database
# - DATABASE_URL is automatically set in the Docker environment
#
# Manual Schema Override:
# - You can manually set the schema by running:
#   * npm run setup-schema:sqlite
#   * npm run setup-schema:postgresql
