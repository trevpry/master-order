model TimeEntry {
  id          Int       @id @default(autoincrement())
  description String?
  startTime   DateTime
  endTime     DateTime?
  minutes     Int?
  taskId      Int?
  projectId   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?  @relation(fields: [projectId], references: [id])
  task        Task?     @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([startTime])
}

model Goal {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  type         String    @default("project")
  targetValue  Int?
  currentValue Int?      @default(0)
  unit         String?
  deadline     DateTime?
  status       String    @default("active")
  projectId    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project?  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([status])
}

model TaskDependency {
  id              Int      @id @default(autoincrement())
  dependentTaskId Int
  dependsOnTaskId Int
