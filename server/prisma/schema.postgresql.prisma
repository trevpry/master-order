  filename     String
  originalName String?
  path         String
  url          String?
  size         Int?
  mimetype     String?
  galleryId    Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  height       Int?
  width        Int?
  gallery      BackgroundGallery? @relation(fields: [galleryId], references: [id])

