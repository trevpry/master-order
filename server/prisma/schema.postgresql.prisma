generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                                Int       @id @default(autoincrement())
  collectionName                    String?
  tvdbToken                         String?
  tvdbTokenExpiry                   DateTime?
  comicVineApiKey                   String?
  plexToken                         String?
  plexUrl                           String?
  tvdbApiKey                        String?
  tvdbBearerToken                   String?
  selectedPlayer                    String?
  selectedPlexUser                  String?
  timezone                          String?   @default("UTC")
  tvGeneralPercent                  Int       @default(50)
  moviesGeneralPercent              Int       @default(50)
  customOrderPercent                Int       @default(0)
  partiallyWatchedCollectionPercent Int       @default(75)
  ignoredMovieCollections           String?
  ignoredTVCollections              String?
  christmasFilterEnabled            Boolean   @default(false)
  plexSyncInterval                  Int       @default(12)
  stashSyncInterval                 Int       @default(24)
  komgaUrl                          String?
  komgaApiKey                       String?
  stashUrl                          String?
  stashApiKey                       String?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
}

model EddieSettings {
  id             Int     @id @default(autoincrement())
  weatherEnabled Boolean @default(false)
  weatherUnits   String  @default("metric")
  weatherApiKey  String?
  weatherLocation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id           Int      @id @default(autoincrement())
  customerName String
  orderDate    DateTime @default(now())
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomOrder {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  icon        String?
  parentOrderId Int?            // Foreign key for parent custom order
  
  // Music playlist fields
  playlistRatingKey String?     // For Plex playlists
  customPlaylistId  Int?        // For custom playlists
  
  // Background gallery fields
  backgroundGalleryId Int?      // For background galleries
  
  items       CustomOrderItem[]
  referencingItems CustomOrderItem[] @relation("SubOrderReference") // Items that reference this order as a sub-order
  
  // Self-referencing relationships for hierarchical orders
  parentOrder CustomOrder?      @relation("OrderHierarchy", fields: [parentOrderId], references: [id])
  subOrders   CustomOrder[]     @relation("OrderHierarchy")
  
  // Playlist relationships
  plexPlaylist    PlexPlaylist?  @relation(fields: [playlistRatingKey], references: [ratingKey])
  customPlaylist  CustomPlaylist? @relation(fields: [customPlaylistId], references: [id])
  
  // Background gallery relationship
  backgroundGallery BackgroundGallery? @relation(fields: [backgroundGalleryId], references: [id])
}

model CustomOrderItem {
  id                     Int               @id @default(autoincrement())
  customOrderId          Int
  mediaType              String
  plexKey                String?
  title                  String
  seasonNumber           Int?
  episodeNumber          Int?
  seriesTitle            String?
  comicSeries            String?
  comicYear              Int?
  comicIssue             String?
  comicVolume            String?
  comicPublisher         String?
  comicVineId            String?
  comicVineDetailsJson   String?
  
  // NEW: Comprehensive ComicVine fields
  comicVineSeriesId      Int?
  comicVineIssueId       Int?
  comicIssueName         String?
  comicDescription       String?
  comicCoverDate         String?
  comicStoreDate         String?
  comicCreators          String?
  comicCharacters        String?
  comicStoryArcs         String?
  
  customTitle            String?
  bookTitle              String?
  bookAuthor             String?
  bookYear               Int?
  bookIsbn               String?
  bookPublisher          String?
  bookOpenLibraryId      String?
  bookCoverUrl           String?
  bookPageCount          Int?
  bookCurrentPage        Int?
  bookPercentRead        Float?
  storyTitle             String?
  storyAuthor            String?
  storyYear              Int?
  storyUrl               String?
  storyContainedInBookId Int?
  storyCoverUrl          String?
  sortOrder              Int               @default(0)
  isWatched              Boolean           @default(false)
  isFromTvdbOnly         Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  artworkLastCached      DateTime?
  artworkMimeType        String?
  localArtworkPath       String?
  originalArtworkUrl     String?
  webTitle               String?
  webUrl                 String?
  webDescription         String?
  tvdbId                 String?
  tvdbYear               Int?
  tvdbOverview           String?
  tvdbGenres             String?
  tvdbDirector           String?
  tvdbStudio             String?
  tvdbArtworkUrl         String?
  referencedCustomOrderId Int?              // For sub-order items, references the CustomOrder id
  
  // Komga integration fields
  komgaUrl               String?
  komgaSeriesId          String?
  komgaBookId            String?
  komgaSeriesUrl         String?
  komgaMetadata          String?
  
  storyContainedInBook   CustomOrderItem?  @relation("StoryInBook", fields: [storyContainedInBookId], references: [id])
  containedStories       CustomOrderItem[] @relation("StoryInBook")
  referencedCustomOrder  CustomOrder?      @relation("SubOrderReference", fields: [referencedCustomOrderId], references: [id])
  customOrder            CustomOrder       @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  
  // Watch logs for this item
  watchLogs              WatchLog[]
}

model PlexLibrarySection {
  id               Int          @id @default(autoincrement())
  sectionKey       String       @unique
  title            String
  type             String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  agent            String?
  allowSync        Int?
  art              String?
  composite        String?
  content          String?
  contentChangedAt Int?
  createdAt_plex   Int?
  directory        String?
  filters          String?
  hidden           Int?
  language         String?
  refreshing       Int?
  scannedAt        Int?
  scanner          String?
  thumb            String?
  updatedAt_plex   Int?
  uuid             String?
  movies           PlexMovie[]
  tvShows          PlexTVShow[]
  artists          PlexArtist[]
  albums           PlexAlbum[]
  tracks           PlexTrack[]
  playlists        PlexPlaylist[]
}

model PlexTVShow {
  id              Int                  @id @default(autoincrement())
  ratingKey       String               @unique
  title           String
  year            Int?
  summary         String?
  thumb           String?
  art             String?
  leafCount       Int?
  viewedLeafCount Int?
  addedAt         Int?
  updatedAt_plex  Int?
  collections     String?
  sectionKey      String
  lastSyncedAt    DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  childCount      Int?
  guid            String?
  index           Int?
  key             String?
  lastViewedAt    Int?
  skipCount       Int?
  type            String?
  viewCount       Int?
  genres          PlexGenre[]
  guids           PlexGuid[]
  images          PlexImage[]
  labels          PlexLabel[]
  seasons         PlexSeason[]
  section         PlexLibrarySection   @relation(fields: [sectionKey], references: [sectionKey])
  ultraBlurColors PlexUltraBlurColor[]
}

model PlexSeason {
  id                  Int                  @id @default(autoincrement())
  ratingKey           String               @unique
  title               String
  index               Int
  showRatingKey       String
  leafCount           Int?
  viewedLeafCount     Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addedAt             Int?
  guid                String?
  key                 String?
  lastViewedAt        Int?
  librarySectionID    Int?
  librarySectionKey   String?
  librarySectionTitle String?
  parentGuid          String?
  parentIndex         Int?
  parentKey           String?
  parentRatingKey     String?
  parentThumb         String?
  parentTitle         String?
  skipCount           Int?
  summary             String?
  thumb               String?
  type                String?
  updatedAt_plex      Int?
  viewCount           Int?
  episodes            PlexEpisode[]
  guids               PlexGuid[]
  images              PlexImage[]
  show                PlexTVShow           @relation(fields: [showRatingKey], references: [ratingKey])
  ultraBlurColors     PlexUltraBlurColor[]
}

model PlexEpisode {
  id                    Int                  @id @default(autoincrement())
  ratingKey             String               @unique
  title                 String
  index                 Int
  seasonIndex           Int
  showTitle             String
  seasonRatingKey       String
  viewCount             Int?
  lastViewedAt          Int?
  addedAt               Int?
  summary               String?
  thumb                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  originallyAvailableAt String?
  duration              Int?
  grandparentGuid       String?
  grandparentKey        String?
  grandparentRatingKey  String?
  grandparentThumb      String?
  grandparentTitle      String?
  guid                  String?
  key                   String?
  librarySectionID      Int?
  librarySectionKey     String?
  librarySectionTitle   String?
  parentGuid            String?
  parentIndex           Int?
  parentKey             String?
  parentRatingKey       String?
  parentThumb           String?
  parentTitle           String?
  skipCount             Int?
  titleSort             String?
  type                  String?
  updatedAt_plex        Int?
  directors             PlexDirector[]
  season                PlexSeason           @relation(fields: [seasonRatingKey], references: [ratingKey])
  guids                 PlexGuid[]
  images                PlexImage[]
  media                 PlexMedia[]
  ratings               PlexRating[]
  roles                 PlexRole[]
  ultraBlurColors       PlexUltraBlurColor[]
  writers               PlexWriter[]
}

model PlexMovie {
  id                    Int                  @id @default(autoincrement())
  ratingKey             String               @unique
  title                 String
  year                  Int?
  summary               String?
  thumb                 String?
  art                   String?
  viewCount             Int?
  lastViewedAt          Int?
  addedAt               Int?
  updatedAt_plex        Int?
  collections           String?
  sectionKey            String
  lastSyncedAt          DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  originallyAvailableAt String?
  audienceRating        Float?
  audienceRatingImage   String?
  chapterSource         String?
  contentRating         String?
  duration              Int?
  guid                  String?
  key                   String?
  librarySectionID      Int?
  librarySectionKey     String?
  librarySectionTitle   String?
  primaryExtraKey       String?
  rating                Float?
  ratingImage           String?
  skipCount             Int?
  slug                  String?
  studio                String?
  tagline               String?
  titleSort             String?
  type                  String?
  countries             PlexCountry[]
  directors             PlexDirector[]
  genres                PlexGenre[]
  guids                 PlexGuid[]
  images                PlexImage[]
  labels                PlexLabel[]
  media                 PlexMedia[]
  section               PlexLibrarySection   @relation(fields: [sectionKey], references: [sectionKey])
  producers             PlexProducer[]
  ratings               PlexRating[]
  roles                 PlexRole[]
  ultraBlurColors       PlexUltraBlurColor[]
  writers               PlexWriter[]
}

model TvdbSeries {
  id               Int           @id @default(autoincrement())
  tvdbId           String        @unique
  name             String
  slug             String?
  image            String?
  firstAired       String?
  lastAired        String?
  nextAired        String?
  status           String?
  overview         String?
  year             String?
  country          String?
  originalCountry  String?
  originalLanguage String?
  averageRuntime   Int?
  score            Float?
  lastUpdated      String?
  lastSyncedAt     DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  artworks         TvdbArtwork[]
  seasons          TvdbSeason[]
}

model TvdbSeason {
  id           Int           @id @default(autoincrement())
  tvdbId       String        @unique
  seriesTvdbId String
  number       Int
  name         String?
  image        String?
  overview     String?
  year         Int?
  lastUpdated  String?
  lastSyncedAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  artworks     TvdbArtwork[]
  episodes     TvdbEpisode[]
  series       TvdbSeries    @relation(fields: [seriesTvdbId], references: [tvdbId])
}

model TvdbEpisode {
  id           Int        @id @default(autoincrement())
  tvdbId       String     @unique
  seasonTvdbId String
  seriesTvdbId String
  number       Int
  seasonNumber Int
  name         String?
  overview     String?
  image        String?
  aired        String?
  runtime      Int?
  finaleType   String?
  year         Int?
  lastUpdated  String?
  lastSyncedAt DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  season       TvdbSeason @relation(fields: [seasonTvdbId], references: [tvdbId])
}

model TvdbArtwork {
  id           Int         @id @default(autoincrement())
  tvdbId       String
  seriesTvdbId String?
  seasonTvdbId String?
  image        String
  thumbnail    String?
  language     String?
  type         Int
  width        Int?
  height       Int?
  score        Float?
  includesText Boolean?
  lastUpdated  String?
  lastSyncedAt DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  season       TvdbSeason? @relation(fields: [seasonTvdbId], references: [tvdbId])
  series       TvdbSeries? @relation(fields: [seriesTvdbId], references: [tvdbId])

  @@unique([tvdbId, seriesTvdbId, seasonTvdbId], name: "artwork_unique_context")
}

model PlexDirector {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  episodeRatingKey String?
  tag              String
  filter           String?
  tagKey           String?
  thumb            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexGenre {
  id             Int         @id @default(autoincrement())
  movieRatingKey String?
  showRatingKey  String?
  tag            String
  filter         String?
  tagKey         String?
  thumb          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  show           PlexTVShow? @relation(fields: [showRatingKey], references: [ratingKey])
  movie          PlexMovie?  @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexProducer {
  id             Int        @id @default(autoincrement())
  movieRatingKey String?
  tag            String
  filter         String?
  tagKey         String?
  thumb          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  movie          PlexMovie? @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexWriter {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  episodeRatingKey String?
  tag              String
  filter           String?
  tagKey           String?
  thumb            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexRole {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  episodeRatingKey String?
  tag              String
  filter           String?
  tagKey           String?
  role             String?
  thumb            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexCountry {
  id             Int        @id @default(autoincrement())
  movieRatingKey String?
  tag            String
  filter         String?
  tagKey         String?
  thumb          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  movie          PlexMovie? @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexRating {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  episodeRatingKey String?
  image            String?
  value            Float?
  type             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexGuid {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  showRatingKey    String?
  seasonRatingKey  String?
  episodeRatingKey String?
  id_value         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  season           PlexSeason?  @relation(fields: [seasonRatingKey], references: [ratingKey])
  show             PlexTVShow?  @relation(fields: [showRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexMedia {
  id                    Int          @id @default(autoincrement())
  movieRatingKey        String?
  episodeRatingKey      String?
  id_value              String?
  duration              Int?
  bitrate               Int?
  width                 Int?
  height                Int?
  aspectRatio           Float?
  audioChannels         Int?
  audioCodec            String?
  videoCodec            String?
  videoResolution       String?
  container             String?
  videoFrameRate        String?
  optimizedForStreaming Boolean?
  selected              Boolean?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  episode               PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  movie                 PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexImage {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  showRatingKey    String?
  seasonRatingKey  String?
  episodeRatingKey String?
  alt              String?
  type             String?
  url              String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  season           PlexSeason?  @relation(fields: [seasonRatingKey], references: [ratingKey])
  show             PlexTVShow?  @relation(fields: [showRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexUltraBlurColor {
  id               Int          @id @default(autoincrement())
  movieRatingKey   String?
  showRatingKey    String?
  seasonRatingKey  String?
  episodeRatingKey String?
  topLeft          String?
  topRight         String?
  bottomLeft       String?
  bottomRight      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  episode          PlexEpisode? @relation(fields: [episodeRatingKey], references: [ratingKey])
  season           PlexSeason?  @relation(fields: [seasonRatingKey], references: [ratingKey])
  show             PlexTVShow?  @relation(fields: [showRatingKey], references: [ratingKey])
  movie            PlexMovie?   @relation(fields: [movieRatingKey], references: [ratingKey])
}

model PlexLabel {
  id             Int         @id @default(autoincrement())
  movieRatingKey String?
  showRatingKey  String?
  tag            String
  filter         String?
  tagKey         String?
  thumb          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  show           PlexTVShow? @relation(fields: [showRatingKey], references: [ratingKey])
  movie          PlexMovie?  @relation(fields: [movieRatingKey], references: [ratingKey])
}

model WatchLog {
  id              Int      @id @default(autoincrement())
  mediaType       String   // 'tv', 'movie', 'book', 'comic', 'shortstory'
  activityType    String   @default("watch") // 'watch' or 'read'
  title           String
  seriesTitle     String?  // For TV episodes, the series name
  seasonNumber    Int?     // For TV episodes
  episodeNumber   Int?     // For TV episodes
  plexKey         String?  // If available
  customOrderItemId Int?   // Link to custom order item if applicable
  startTime       DateTime
  endTime         DateTime?
  duration        Int?     // Duration in minutes
  totalWatchTime  Int?     // Actual watch/read time in minutes (for pause tracking)
  isCompleted     Boolean  @default(true) // Whether the full content was watched/read
  isPaused        Boolean  @default(false) // Current pause state for active sessions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Optional relation to custom order item
  customOrderItem CustomOrderItem? @relation(fields: [customOrderItemId], references: [id])
}

// Music models for Plex music library support
model PlexArtist {
  id                Int      @id @default(autoincrement())
  ratingKey         String   @unique
  key               String
  guid              String?
  type              String   @default("artist")
  title             String
  titleSort         String?
  summary           String?
  index             Int?
  thumb             String?
  art               String?
  addedAt           DateTime?
  updatedAt         DateTime?
  librarySectionID  Int?
  
  // Collections field for Plex Collections
  collections       String?
  
  // Relations
  librarySection    PlexLibrarySection? @relation(fields: [librarySectionID], references: [id])
  albums            PlexAlbum[]
  
  @@map("PlexArtist")
}

model PlexAlbum {
  id                Int      @id @default(autoincrement())
  ratingKey         String   @unique
  key               String
  parentRatingKey   String?  // Artist ratingKey
  guid              String?
  type              String   @default("album")
  title             String
  titleSort         String?
  summary           String?
  index             Int?
  year              Int?
  thumb             String?
  art               String?
  parentThumb       String?
  originallyAvailableAt DateTime?
  addedAt           DateTime?
  updatedAt         DateTime?
  librarySectionID  Int?
  
  // Collections field for Plex Collections
  collections       String?
  
  // Relations
  librarySection    PlexLibrarySection? @relation(fields: [librarySectionID], references: [id])
  artist            PlexArtist? @relation(fields: [parentRatingKey], references: [ratingKey])
  tracks            PlexTrack[]
  
  @@map("PlexAlbum")
}

model PlexTrack {
  id                Int      @id @default(autoincrement())
  ratingKey         String   @unique
  key               String
  parentRatingKey   String?  // Album ratingKey
  grandparentRatingKey String? // Artist ratingKey
  guid              String?
  type              String   @default("track")
  title             String
  titleSort         String?
  originalTitle     String?  // Original title if different
  summary           String?
  index             Int?
  duration          Int?     // Duration in milliseconds
  thumb             String?
  art               String?
  parentThumb       String?
  grandparentThumb  String?
  addedAt           DateTime?
  updatedAt         DateTime?
  librarySectionID  Int?
  
  // Rating and play data
  rating            Float?    // Overall rating
  userRating        Float?    // User's personal rating
  viewCount         Int?      // Number of times played
  skipCount         Int?      // Number of times skipped
  lastViewedAt      DateTime? // Last time this track was played
  
  // MusicBrainz and external IDs
  musicBrainzTrackId String?  // MusicBrainz Track ID
  lastFmId          String?   // Last.fm ID
  plexMusicId       String?   // Plex Music ID
  
  // Media technical information
  bitrate           Int?      // Audio bitrate
  container         String?   // File container (mp3, flac, etc.)
  audioCodec        String?   // Audio codec
  audioChannels     Int?      // Number of audio channels
  
  // File information
  file              String?   // Full file path
  size              Int?      // File size in bytes
  
  // Relations
  librarySection    PlexLibrarySection? @relation(fields: [librarySectionID], references: [id])
  album             PlexAlbum? @relation(fields: [parentRatingKey], references: [ratingKey])
  
  @@map("PlexTrack")
}

// Stash models
model StashScene {
  id               String   @id
  title            String
  details          String?
  url              String?
  date             String?
  rating           Int?
  organized        Boolean  @default(false)
  osHash           String?
  checksum         String?
  phash            String?
  oCounter         Int?
  path             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastSyncedAt     DateTime @default(now())
  fileModTime      DateTime?
  
  // Scene specific fields
  studio           String?      // Studio name for display
  studioId         String?      // Studio ID for relationship
  code             String?
  director         String?
  synopsis         String?
  
  // Play status fields
  lastPlayedAt     DateTime?
  resumeTime       Float?
  playDuration     Float?
  playCount        Int?
  duration         Float?      // Video duration in seconds
  
  // Phase 2: Enhanced technical metadata
  fileSize         Int?                    // File size in bytes
  bitrate          Float?                  // Video bitrate
  resolution       String?                 // Resolution (1080p, 4K, etc.)
  width            Int?                    // Video width in pixels
  height           Int?                    // Video height in pixels
  frameRate        Float?                  // Frames per second
  codec            String?                 // Video codec
  
  // Phase 2: Enhanced user interaction
  userRating       Float?                  // User's personal rating (0-10)
  favorite         Boolean  @default(false) // User favorite flag
  watchedComplete  Boolean  @default(false) // Scene watched to completion
  skipCount        Int      @default(0)     // Times user skipped scene
  avgWatchTime     Float?                  // Average watch time percentage
  totalWatchTime   Float    @default(0.0)  // Total accumulated watch time
  
  // Phase 2: Performance and discovery metrics
  popularityScore  Float    @default(0.0)  // Calculated popularity score
  qualityScore     Float?                  // Content quality assessment
  trendingScore    Float    @default(0.0)  // Recent popularity trend
  discoveryScore   Float    @default(0.0)  // Discovery algorithm score
  
  // Phase 2: Content analysis and classification
  sceneDominantColors String?             // JSON array of dominant colors
  sceneKeywords    String?                // JSON array of auto-extracted keywords
  contentFlags     String?                // JSON array of content flags
  aiGeneratedTags  String?                // JSON array of AI-suggested tags
  moodScore        Float?                 // Mood/tone score (0-10)
  actionIntensity  Float?                 // Action intensity level (0-10)
  
  // Relationships
  performers       StashScenePerformer[]
  tags             StashSceneTag[]
  studioObject     StashStudio? @relation(fields: [studioId], references: [id])
  clips            StashClip[]
  markers          StashMarker[]
  watchHistory     StashSceneWatchHistory[]
  
  @@map("StashScene")
}

model StashSceneWatchHistory {
  id         Int      @id @default(autoincrement())
  sceneId    String
  watchedAt  DateTime @default(now())
  platform   String?  // e.g., "web", "android", "ios"
  progress   Float?   // Watch progress (0-1)
  
  // Relationship
  scene      StashScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  
  @@map("StashSceneWatchHistory")
}

model StashClip {
  id               Int      @id @default(autoincrement())
  sceneId          String
  clipIndex        Int      // 0-based index (clip 1, clip 2, etc.)
  startTime        Float    // Start time in seconds
  endTime          Float    // End time in seconds
  duration         Float    // Duration in seconds
  watched          Boolean  @default(false)
  watchedAt        DateTime?
  createdAt        DateTime @default(now())
  title            String?  // Optional title (from marker or auto-generated)
  markerBased      Boolean  @default(false) // True if created from markers, false if time-based
  
  // Relationship
  scene            StashScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  
  @@unique([sceneId, clipIndex])
  @@map("StashClip")
}

model StashMarker {
  id               Int      @id @default(autoincrement())
  stashId          String   @unique  // Stash's internal marker ID
  sceneId          String   // Foreign key to StashScene
  title            String
  seconds          Float    // Marker position in seconds
  primaryTag       String?  // Primary tag name
  primaryTagId     String?  // Primary tag ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastSyncedAt     DateTime @default(now())
  
  // Relationships
  scene            StashScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  
  @@map("StashMarker")
}

model StashPerformer {
  id            String   @id
  name          String
  disambiguation String?
  alias         String?
  favorite      Boolean  @default(false)
  ignore_auto_tag Boolean @default(false)
  
  // Physical characteristics
  birthdate     String?
  ethnicity     String?
  country       String?
  eye_color     String?
  height        String?
  measurements  String?
  fake_tits     String?
  career_length String?
  tattoos       String?
  piercings     String?
  
  // Images and URLs
  image         String?
  instagram     String?
  twitter       String?
  url           String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSyncedAt  DateTime @default(now())
  
  // Relationships
  scenes        StashScenePerformer[]
  tags          StashPerformerTag[]
  galleries     StashGalleryPerformer[]
  images        StashImagePerformer[]     // Added for standalone images
  
  @@map("StashPerformer")
}

model StashStudio {
  id           String   @id
  name         String   @unique
  url          String?
  image        String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())
  
  // Relationships
  scenes       StashScene[]
  galleries    StashGallery[]
  images       StashImage[]             // Added for standalone images
  
  @@map("StashStudio")
}

model StashTag {
  id           String   @id
  name         String   @unique
  description  String?
  image        String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())
  
  // Relationships
  scenes       StashSceneTag[]
  performers   StashPerformerTag[]
  galleries    StashGalleryTag[]         // Added for galleries
  images       StashImageTag[]           // Added for standalone images
  
  @@map("StashTag")
}

// Junction tables for many-to-many relationships
model StashScenePerformer {
  sceneId     String
  performerId String
  
  scene       StashScene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  performer   StashPerformer  @relation(fields: [performerId], references: [id], onDelete: Cascade)
  
  @@id([sceneId, performerId])
  @@map("StashScenePerformer")
}

model StashSceneTag {
  sceneId String
  tagId   String
  
  scene   StashScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  tag     StashTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([sceneId, tagId])
  @@map("StashSceneTag")
}

model StashPerformerTag {
  performerId String
  tagId       String
  
  performer   StashPerformer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  tag         StashTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([performerId, tagId])
  @@map("StashPerformerTag")
}

// Stash Gallery and Image models
model StashGallery {
  id           String   @id
  title        String?
  code         String?
  date         String?
  details      String?
  photographer String?
  url          String?
  rating       Int?     // 1-5 stars
  organized    Boolean  @default(false)
  studio       String?
  studioId     String?
  
  // File paths for gallery
  path         String?
  checksum     String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())
  
  // Relationships
  images       StashImage[]
  performers   StashGalleryPerformer[]
  tags         StashGalleryTag[]
  studioObject StashStudio? @relation(fields: [studioId], references: [id])
  
  @@map("StashGallery")
}

model StashImage {
  id           String   @id
  galleryId    String?  // Made optional to support standalone images
  title        String?
  code         String?  // Added missing fields
  date         String?
  details      String?
  photographer String?
  url          String?
  rating       Int?
  organized    Boolean  @default(false)
  studio       String?
  studioId     String?
  path         String?
  checksum     String?
  fileModTime  DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())
  
  // Relationships
  gallery      StashGallery?           @relation(fields: [galleryId], references: [id], onDelete: Cascade) // Made optional
  performers   StashImagePerformer[]   // Added for standalone images
  tags         StashImageTag[]         // Added for standalone images
  studioObject StashStudio?            @relation(fields: [studioId], references: [id]) // Added studio relationship
  
  @@map("StashImage")
}

// Junction tables for gallery relationships
model StashGalleryPerformer {
  galleryId   String
  performerId String
  
  gallery     StashGallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  performer   StashPerformer  @relation(fields: [performerId], references: [id], onDelete: Cascade)
  
  @@id([galleryId, performerId])
  @@map("StashGalleryPerformer")
}

model StashGalleryTag {
  galleryId String
  tagId     String
  
  gallery   StashGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  tag       StashTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([galleryId, tagId])
  @@map("StashGalleryTag")
}

// Junction tables for standalone image relationships
model StashImagePerformer {
  imageId     String
  performerId String
  
  image       StashImage     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  performer   StashPerformer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  
  @@id([imageId, performerId])
  @@map("StashImagePerformer")
}

model StashImageTag {
  imageId String
  tagId   String
  
  image   StashImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag     StashTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([imageId, tagId])
  @@map("StashImageTag")
}

// Plex Playlist models for music playlists
model PlexPlaylist {
  id                Int      @id @default(autoincrement())
  ratingKey         String   @unique
  key               String
  guid              String?
  type              String   @default("playlist")
  title             String
  titleSort         String?
  summary           String?
  smart             Boolean  @default(false) // Smart playlist vs manual playlist
  playlistType      String?  // audio, video, photo
  thumb             String?
  composite         String?
  duration          Int?     // Total duration in milliseconds
  leafCount         Int?     // Number of items in playlist
  addedAt           DateTime?
  updatedAt         DateTime?
  librarySectionID  Int?
  
  // Relations
  librarySection    PlexLibrarySection? @relation(fields: [librarySectionID], references: [id])
  items             PlexPlaylistItem[]
  customOrders      CustomOrder[]       // Custom orders that reference this playlist
  
  @@map("PlexPlaylist")
}

model PlexPlaylistItem {
  id                Int      @id @default(autoincrement())
  playlistRatingKey String   // Playlist ratingKey
  ratingKey         String   // Item ratingKey (track, album, etc.)
  type              String   // track, album, artist
  title             String?
  duration          Int?     // Duration in milliseconds
  addedAt           DateTime?
  
  // Relations
  playlist          PlexPlaylist @relation(fields: [playlistRatingKey], references: [ratingKey], onDelete: Cascade)
  
  @@map("PlexPlaylistItem")
}

// Custom Playlist models (separate from Plex)
model CustomPlaylist {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean   @default(false)
  createdBy   String?   // User identifier (could be username or ID)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  tracks      CustomPlaylistTrack[]
  customOrders CustomOrder[]         // Custom orders that reference this playlist
  
  @@map("CustomPlaylist")
}

model CustomPlaylistTrack {
  id           Int             @id @default(autoincrement())
  playlistId   Int
  ratingKey    String          // Plex track ratingKey
  title        String?         // Track title for quick reference
  artist       String?         // Artist name for quick reference
  album        String?         // Album name for quick reference
  duration     Int?            // Duration in milliseconds
  sortOrder    Int             @default(0) // Order within playlist
  addedAt      DateTime        @default(now())
  
  // Relations
  playlist     CustomPlaylist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  @@map("CustomPlaylistTrack")
}

// Dating Management Models
model DatingApp {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  connections Connection[]
  
  @@map("DatingApp")
}

model Connection {
  id          Int       @id @default(autoincrement())
  appId       Int
  
  // Basic guy details
  guyName     String
  age         Int?
  location    String?
  profileUrl  String?
  bio         String?
  photos      String?   // JSON string of photo URLs
  
  // Physical attributes (common across apps)
  height      String?
  weight      String?
  bodyType    String?
  bodyHair    String?   // Body hair amount/type
  ethnicity   String?
  hair        String?   // Hair color/type
  
  // App-specific fields (Scruff, Grindr, etc.)
  tribe       String?   // Scruff: Bear, Otter, Wolf, etc.
  position    String?   // Top, Bottom, Versatile, etc.
  hivStatus   String?   // Negative, Positive, Undetectable, etc.
  lastTested  String?   // Recent test date
  lookingFor  String?   // Chat, Dates, Friends, etc.
  relationshipStatus String? // Single, Partnered, etc.
  sexPractices String?  // Sexual practices preferences
  
  // Scruff-specific detailed fields
  verification     String?  // Verified badge type
  globalPosition   String?  // Global grid position
  travelMode       Boolean  @default(false)
  privatePhotos    Int      @default(0) // Count of private photos
  woofCount        Int      @default(0) // Number of woofs received
  viewCount        Int      @default(0) // Profile view count
  
  // "What interests me" section
  interests        String?  // JSON string of interests
  
  // "They are" preferences
  theyAre          String?  // JSON string of preferences for partner
  theyAreInto      String?  // JSON string of what partner should be into
  
  // Identity fields
  pronouns         String?  // Pronoun preferences
  genderIdentity   String?  // Gender identity
  
  // "Open to" preferences
  openTo           String?  // JSON string of what they're open to
  
  // Sexual health details
  sexualHealth     String?  // JSON string of sexual health info
  
  // Distance and activity
  distance         String?  // "2.3 mi", "1.5 km"
  
  // Conversation tracking
  firstContact DateTime @default(now())
  lastContact  DateTime @default(now())
  status       ConnectionStatus @default(ACTIVE)
  notes        String?
  
  // Stats
  messagesExchanged Int @default(0)
  responseRate     Float @default(0.0) // Percentage
  avgResponseTime  Int?  // Minutes
  
  // Import tracking
  source               String?  // "manual", "screenshot_import", etc.
  extractionConfidence Float?   // 0.0 - 1.0 confidence score
  
  // Relations
  app         DatingApp  @relation(fields: [appId], references: [id])
  dates       Date[]
  encounters  Encounter[]
  messages    Message[]
  screenshots Screenshot[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@unique([appId, guyName])
  @@map("Connection")
}

model Date {
  id           Int       @id @default(autoincrement())
  connectionId Int?
  
  // Date details
  guyName      String
  dateTime     DateTime
  location     String
  activity     String
  duration     Int?      // Minutes
  cost         Float?    // How much spent
  
  // Rating and notes
  rating       Int?      // 1-5 stars
  chemistry    Int?      // 1-5 rating
  conversation Int?      // 1-5 rating
  attraction   Int?      // 1-5 rating
  notes        String?
  
  // Outcome
  outcome      DateOutcome @default(NEUTRAL)
  secondDate   Boolean     @default(false)
  
  connection   Connection? @relation(fields: [connectionId], references: [id])
  encounters   Encounter[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@map("Date")
}

model Encounter {
  id           Int       @id @default(autoincrement())
  connectionId Int?
  dateId       Int?
  
  // Encounter details
  guyName      String
  dateTime     DateTime
  location     String?
  type         EncounterType
  duration     Int?      // Minutes
  
  // Ratings
  satisfaction Int?      // 1-5 rating
  performance  Int?      // 1-5 rating
  chemistry    Int?      // 1-5 rating
  notes        String?
  
  // Safety and health
  protection   Boolean   @default(false)
  tested       Boolean   @default(false)
  testDate     DateTime?
  
  connection   Connection? @relation(fields: [connectionId], references: [id])
  date         Date?       @relation(fields: [dateId], references: [id])
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@map("Encounter")
}

model Message {
  id           Int       @id @default(autoincrement())
  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  
  // Message content
  content      String
  timestamp    DateTime
  sender       String    // "me" or participant name
  
  // OCR metadata
  confidence   Float?    // OCR confidence score
  screenshotId String?   // Reference to original screenshot
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@map("Message")
}

model Screenshot {
  id           String    @id @default(cuid())
  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  
  // File info
  filename     String
  originalName String
  size         Int
  
  // Processing status
  processed    Boolean   @default(false)
  ocrText      String?   // Raw OCR output
  messagesExtracted Int @default(0)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@map("Screenshot")
}

enum ConnectionStatus {
  ACTIVE
  PAUSED
  BLOCKED
  UNMATCHED
  MET
  RELATIONSHIP
}

enum DateOutcome {
  GREAT
  GOOD
  NEUTRAL
  POOR
  TERRIBLE
}

enum EncounterType {
  HOOKUP
  FWB
  RELATIONSHIP
  ONE_TIME
}

// Notes Management Models
model Note {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @default("")
  type        String   @default("note")
  tags        String   @default("[]")  // JSON array of tags
  folderId    Int?
  userId      Int      @default(1)
  isFavorite  Boolean  @default(false)
  isPublic    Boolean  @default(false)
  attachments String   @default("[]")  // JSON array of attachments
  links       String   @default("[]")  // JSON array of links
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  folder      NoteFolder? @relation(fields: [folderId], references: [id])
  fromLinks   NoteCrossLink[] @relation("FromNote")
  toLinks     NoteCrossLink[] @relation("ToNote")
  dailyNote   DailyNote?
  
  @@index([userId])
  @@index([type])
  @@index([folderId])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([updatedAt])
}

model NoteFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  userId    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  parent   NoteFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children NoteFolder[] @relation("FolderHierarchy")
  notes    Note[]
  
  @@index([userId])
  @@index([parentId])
}

model NoteTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  userId    Int      @default(1)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([count])
}

model NoteCrossLink {
  id         Int      @id @default(autoincrement())
  fromNoteId Int
  toNoteId   Int
  createdAt  DateTime @default(now())
  
  fromNote Note @relation("FromNote", fields: [fromNoteId], references: [id], onDelete: Cascade)
  toNote   Note @relation("ToNote", fields: [toNoteId], references: [id], onDelete: Cascade)
  
  @@unique([fromNoteId, toNoteId])
  @@index([fromNoteId])
  @@index([toNoteId])
}

model NoteTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  content     String   @default("")
  type        String   @default("daily") // daily, weekly, project, etc.
  variables   String   @default("[]")  // JSON array of variable placeholders
  userId      Int      @default(1)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([isDefault])
}

model DailyNote {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // Date for this daily note (normalized to start of day)
  noteId    Int      @unique
  userId    Int      @default(1)
  mood      String?  // morning, evening mood
  weather   String?
  goals     String   @default("[]")  // JSON array of daily goals
  habits    String   @default("[]")  // JSON array of habit completions
  gratitude String   @default("[]")  // JSON array of gratitude entries
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([date])
}

model BackgroundImage {
  id          Int      @id @default(autoincrement())
  filename    String
  originalName String?
  path        String
  url         String?
  size        Int?
  mimetype    String?
  width       Int?
  height      Int?
  galleryId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery BackgroundGallery? @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  
  @@index([galleryId])
}

model BackgroundGallery {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  backgrounds BackgroundImage[]
  customOrders CustomOrder[]
}

// ========================================
// TASKS & PRODUCTIVITY MODELS
// ========================================

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  color       String?  @default("#3B82F6") // Hex color for UI
  status      String   @default("active") // active, completed, archived, on_hold
  priority    String   @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tasks       Task[]
  timeEntries TimeEntry[]
  goals       Goal[]
}

model TaskCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String?  @default("#6B7280") // Hex color for UI
  icon      String?  // Icon name or emoji
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  tasks     Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, completed, cancelled
  priority    String   @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  completedAt DateTime?
  estimatedMinutes Int? // Estimated time to complete
  actualMinutes    Int? // Actual time spent (calculated from time entries)
  
  // Relationships
  projectId   Int?
  categoryId  Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category    TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  
  // Task Dependencies
  dependencies     TaskDependency[] @relation("DependentTask")
  dependentTasks   TaskDependency[] @relation("DependsOnTask")
  
  @@index([projectId])
  @@index([categoryId])
  @@index([status])
  @@index([dueDate])
}

model TimeEntry {
  id          Int      @id @default(autoincrement())
  description String?
  startTime   DateTime
  endTime     DateTime?
  minutes     Int?     // Calculated duration in minutes
  
  // Relationships
  taskId      Int?
  projectId   Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  @@index([taskId])
  @@index([projectId])
  @@index([startTime])
}

model Goal {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        String   @default("project") // project, daily, weekly, monthly, yearly
  targetValue Int?     // For measurable goals
  currentValue Int?    @default(0)
  unit        String?  // hours, tasks, etc.
  deadline    DateTime?
  status      String   @default("active") // active, completed, paused, cancelled
  
  // Relationships
  projectId   Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  @@index([projectId])
  @@index([type])
  @@index([status])
}

model TaskDependency {
  id              Int      @id @default(autoincrement())
  dependentTaskId Int      // Task that depends on another task
  dependsOnTaskId Int      // Task that must be completed first
  type            String   @default("FINISH_TO_START") // FINISH_TO_START, START_TO_START, FINISH_TO_FINISH, START_TO_FINISH
  
  createdAt       DateTime @default(now())
  
  dependentTask   Task     @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  
  @@unique([dependentTaskId, dependsOnTaskId])
  @@index([dependentTaskId])
  @@index([dependsOnTaskId])
}
