model DailyWeatherSummary {
  id              Int      @id @default(autoincrement())
  date            String   @unique // YYYY-MM-DD format
  conditions      String   // Main weather condition (e.g., "Clear", "Cloudy", "Rain")
  description     String   // Detailed description (e.g., "light rain")
  tempMin         Float?   // Daily minimum temperature
  tempMax         Float?   // Daily maximum temperature
  tempAvg         Float?   // Daily average temperature
  humidity        Int?     // Average humidity percentage
  precipitation   Float?   // Total precipitation in mm
  windSpeed       Float?   // Average wind speed
  pressure        Float?   // Atmospheric pressure
  cloudiness      Int?     // Cloud coverage percentage
  sunrise         String?  // Sunrise time (HH:MM format)
  sunset          String?  // Sunset time (HH:MM format)
  weatherData     String?  // Raw weather data JSON for reference
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =====================================
// UNIFIED BOOKS SYSTEM
// =====================================
// Centralized book management system that replaces distributed book data
// across CustomOrderItems and HistoryBooks with a single source of truth.

model Book {
  id                  Int       @id @default(autoincrement())
  title               String
  author              String?
  isbn                String?   @unique
  publisher           String?
  publishYear         Int?
  description         String?
  coverUrl            String?
  pageCount           Int?
  openLibraryId       String?   @unique
  komgaBookId         String?   @unique
  komgaSeriesId       String?
  komgaUrl            String?
  komgaMetadata       String?
  
  // History Plus migration support
  isHistoryPlusBook   Boolean   @default(false)
  originalHistoryBookId Int?
  
  // Artwork caching (consistent with existing pattern)
  artworkLastCached   DateTime?
  artworkMimeType     String?
  localArtworkPath    String?
  originalArtworkUrl  String?
  
  // Ownership tracking
  owned               Boolean   @default(false)
  
  // Metadata
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  chapters            BookChapter[]
  customOrderItems    CustomOrderItem[]  // Books referenced by custom orders
  historyBookLinks    HistoryBookLink[]  // Links to historical events
  readingSessions     WatchLog[]         // All reading sessions for this book
  bookCompletions     BookCompletion[]   // Completion tracking
  
  @@index([isbn])
  @@index([openLibraryId])
  @@index([isHistoryPlusBook])
  @@index([originalHistoryBookId])
  @@index([komgaBookId])
  @@index([title])
}

model BookChapter {
  id                  Int       @id @default(autoincrement())
  bookId              Int
  title               String
  chapterNumber       Int
  description         String?
  pageStart           Int?
  pageEnd             Int?
  eventId             Int?
  
  // History Plus migration tracking
  originalHistoryChapterId Int?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  book                Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  event               HistoricalEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections            BookSection[]
  chapterCompletions  ChapterCompletion[]
  
  @@unique([bookId, chapterNumber])
  @@index([bookId])
  @@index([eventId])
  @@index([originalHistoryChapterId])
}

model BookSection {
  id                  Int       @id @default(autoincrement())
  chapterId           Int
  title               String
  sectionNumber       Int
  description         String?
  content             String?
  pageStart           Int?
  pageEnd             Int?
  eventId             Int?
  
  // History Plus migration tracking
  originalHistorySectionId Int?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  chapter             BookChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  event               HistoricalEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionCompletions  SectionCompletion[]
  
  @@unique([chapterId, sectionNumber])
  @@index([chapterId])
  @@index([eventId])
  @@index([originalHistorySectionId])
}

// =====================================
// COMPLETION TRACKING SYSTEM
// =====================================
// Granular completion tracking at book, chapter, and section levels

model BookCompletion {
  id          Int       @id @default(autoincrement())
  bookId      Int
  userId      String?   // For future multi-user support, nullable for now
  isCompleted Boolean   @default(false)
  currentPage Int?      // Current reading position
  percentRead Float?    // Calculated reading progress
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  @@unique([bookId, userId])
  @@index([bookId])
}

model ChapterCompletion {
  id          Int         @id @default(autoincrement())
  chapterId   Int
  userId      String?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chapter     BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  @@unique([chapterId, userId])
  @@index([chapterId])
}

model SectionCompletion {
  id          Int         @id @default(autoincrement())
  sectionId   Int
  userId      String?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  section     BookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  @@unique([sectionId, userId])
  @@index([sectionId])
}

// =====================================
// HISTORY PLUS INTEGRATION
// =====================================
// Links books to historical events, replacing HistoryBook model

model HistoryBookLink {
  id        Int               @id @default(autoincrement())
  bookId    Int
  eventId   Int
  createdAt DateTime          @default(now())
  
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  event     HistoricalEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([bookId, eventId])
  @@index([bookId])
  @@index([eventId])
}

// =====================================
// VIDEO GAME LIBRARY SYSTEM
// =====================================
// Unified video game library, similar to Book system

model VideoGame {
  id                  Int       @id @default(autoincrement())
  title               String
  developer           String?
  publisher           String?
  releaseDate         DateTime?
  description         String?
  platforms           String?   // JSON array of platforms
  genres              String?   // JSON array of genres
  rating              Float?    // RAWG rating
  metacriticRating    Int?      // Metacritic score
  rawgId              Int?      @unique  // RAWG API ID
  rawgSlug            String?   @unique  // RAWG slug
  rawgUrl             String?   // RAWG page URL
  
  // Artwork caching (consistent with existing pattern)
  coverUrl            String?
  artworkLastCached   DateTime?
  artworkMimeType     String?
  localArtworkPath    String?
  originalArtworkUrl  String?
  
  // Additional metadata
  esrbRating          String?   // ESRB rating (E, T, M, etc.)
  playtimeHours       Int?      // Average playtime in hours
  website             String?   // Official website
  webvideoUrl         String?   // Associated webvideo URL (e.g., gameplay video, trailer)
  
  // Metadata
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  customOrderItems    CustomOrderItem[]  // Games referenced by custom orders
  gameCompletions     GameCompletion[]   // Completion tracking
  
  @@index([rawgId])
  @@index([rawgSlug])
  @@index([title])
  @@index([platforms])
  @@index([genres])
}

// Game completion tracking
model GameCompletion {
  id              Int       @id @default(autoincrement())
  gameId          Int
  userId          String?   // For future multi-user support, nullable for now
  isCompleted     Boolean   @default(false)
  hoursPlayed     Float?    // Hours played
  percentComplete Float?    // Completion percentage
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  game            VideoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  @@unique([gameId, userId])
  @@index([gameId])
}
