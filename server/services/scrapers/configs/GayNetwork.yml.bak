xPathScrapers:
  sceneScraper:
    scene:
      Title: //div[@class="product-page vid-block"]//h1/text()
      Details: //div[@class="description"]/text()
      URL: &url //link[@rel="alternate" and hreflang="en"]/@href
      # Date: &date
      #   selector: //script[@type="application/ld+json"]/text()
      #   postProcess:
      #     - replace:
      #         - regex: .*"datePublished"\s*:\s*"([^"]+)".*
      #           with: $1
      Image:
        selector: //video/@poster
      Studio:
        Name: //a[@class="site-logo"]/img/@alt
      Performers:
        Name: //div[contains(@class, "text-terciary") and contains(@class, "text-truncate")]
        URL: //div[@class="mt-4"]//a[contains(@class, "h100")]/@href
      Tags:
        Name: 
          selector: //li[@class="list-group-item clearfix cat"]/a/text()
          postProcess:
          - replace:
              - regex: "#"
                with: ""
  movieScraper:
    movie:
      Title: 
        selector: //h1[@class="h4 text-dark"]/text()     
      Image: 
        selector: //div[@class="embed-responsive embed-responsive-2by3 mb-2"]/img/@src
  performerScraper:
    performer:
      Name: 
        selector: //div[@class="p-1 pt-2 text-center h90 text-terciary -bg-black-50 text-truncate"]/text()
        postProcess:
          - replace:
              - regex: "\""
                with: "" 
      Gender:
        fixed: Male       
      URL:
        selector: //link[@rel="canonical"]/@content
      Image: 
        selector: //img[@class="border embed-responsive-item bg-light border-dark obj-cover"]/@src
  sceneSearchScraper:
    # Search for scenes on a performer's page
    scene:
      Title: //a[@class="d-block h110 pt-3 pb-0 px-3 text-truncate text-center text-primary font-weight-bold"]/text()
      URL:
        selector: //a[@class="d-block h110 pt-3 pb-0 px-3 text-truncate text-center text-primary font-weight-bold"]/@href
      Image:
        selector: //div[@class="embed-responsive embed-responsive-16by9 rounded"]/img/@src
  performerSearchScraper:
    # Search for performers - returns list of matching performers with URLs
    performer:
      Name: //div[@class="b-0 l-0 r-0 h6 m-2 pb-1 text-truncate text-center text-dark"]/text()
      URL:
        selector: //a[@class="col-xxl-2 col-xl-3 col-md-3 col-sm-4 col-6 mb-3 "]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.hotcast.fr
      Image:
        selector: //div[@class="embed-responsive embed-responsive-16by9 rounded"]/img/@src    
      performerSceneScraper: performerSceneScraper
  performerSceneScraper:
    # Extract scenes from a performer's detail page
    scene:
      Title: //a[@class="d-block h110 pt-3 pb-0 px-3 text-truncate text-center text-primary font-weight-bold"]/text()
      URL:
        selector: //a[@class="d-block h110 pt-3 pb-0 px-3 text-truncate text-center text-primary font-weight-bold"]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.hotcast.fr
      Performers:
        Name: //div[contains(@class, "text-terciary") and contains(@class, "text-truncate")]
        URL: //div[@class="mt-4"]//a[contains(@class, "h100")]/@href    


