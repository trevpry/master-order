name: GuyBone
sceneByURL:
  - action: scrapeXPath
    url:
      - guybone.com
    scraper: sceneScraper

sceneByFragment:
  - action: scrapeXPath
    scraper: sceneSearchScraper
    # Search for scenes by performers
    # {performer} will be replaced with performer name (spaces converted to underscores, lowercased)
    performerSearchUrl: https://guybone.com/model/{performer}
    # Search for scenes by title on studio page
    # {studio} will be the studio's main page URL (from geviUrl or similar)
    # Results will be filtered by title match
    studioSearchUrl: https://guybone.com/model/{title}

performerByURL:
  - action: scrapeXPath
    url:
      - guybone.com
    scraper: performerScraper

xPathScrapers:
  sceneScraper:
    scene: 
      Title: //h2
      Details: 
        selector: //section[@class="wrapper style1"]/div[@class="container 90%"]
        concat: ' '
      Performers:
        Name: //div[@class="content"]/header/h4/a/text()
        URL: 
          selector: //div[@class="content"]//a/@href
          postProcess:
            - replace:
                - regex: ^
                  with: https://guybone.com
      Date: 
        selector: //header[contains(@class,'major')]/p
        postProcess:
          - replace:
              - regex: ^\s+|\s+$
                with: ""
          - replace:
              - regex: ^(\d{1,2})-0*(\d{1,2})-(\d{4})$
                with: $1/$2/$3
          - parseDate: 01/02/2006
      Tags:
        Name:
          selector: //meta[@name='keywords']/@content
          split: ', '
      Image: //section[@id="banner"]//img/@src
      Studio:
        Name:
          fixed: "Guy Bone"

  performerScraper:
    performer:
      Name: //h2
      Gender:
        fixed: Male
      Ethnicity:
        selector: //td[contains(.,'Ethnicity:')]/following-sibling::td[1]
      Tattoos:
        selector: //td[contains(.,'Tattoos:')]/following-sibling::td[1]
      Piercings:
        selector: //td[contains(.,'Piercings:')]/following-sibling::td[1]
      Height:
        selector: //td[contains(.,'Height:')]/following-sibling::td[1]
        postProcess:
          - replace:
              - regex: "''"
                with: ''
              - regex: "'"
                with: '.'
          - feetToCm: true
      PenisLength:
        selector: //td[contains(.,'Dick Size:')]/following-sibling::td[1]
        postProcess:
          - replace:
              - regex: "''"
                with: ''
              - regex: ^
                with: '0.' 
          - feetToCm: true
      Circumcised:
        selector: //td[contains(.,'Dick:')]/following-sibling::td[1]
      Details:
        selector: //section[@id="one"]//h2/following-sibling::div/div[1]
      Image: //section[@id='banner']//img/@src

  sceneSearchScraper:
    # Search for scenes on a performer's page
    scene:
      Title: //div[@class="row 150%"]/div[@class="4u 12u$(xsmall)"]//h4/text()
      URL:
        selector: //div[@class="row 150%"]/div[@class="4u 12u$(xsmall)"]/a/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://guybone.com
      Image:
        selector: //div[@class="row 150%"]/div[@class="4u 12u$(xsmall)"]//img/@src
      Date:
        selector: //div[@class='content']//header/p
        postProcess:
          - replace:
              - regex: ^\s+|\s+$
                with: ""
          - replace:
              - regex: ^(\d{1,2})-0*(\d{1,2})-(\d{4})$
                with: $1/$2/$3
          - parseDate: 01/02/2006

# Last Updated June 17, 2024
