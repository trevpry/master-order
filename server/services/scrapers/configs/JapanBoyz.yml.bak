name: "Japan Boyz"
sceneByURL:
  - action: scrapeXPath
    url:
      - japanboyz.com
    scraper: sceneScraper
performerByURL:
  - action: scrapeXPath
    url:
      - japanboyz.com/models
    scraper: performerScraper    
sceneByFragment:
  - action: scrapeXPath
    performerSearchScraper: sceneSearchScraper
    titleSearchScraper: sceneScraper
    # Search for scenes by performers
    # {performer} will be replaced with performer name (spaces converted to underscores, lowercased)
    performerSearchUrl: https://guybone.com/model/{performer}
    # Search for scenes by title - direct scene URL
    # {title} will be replaced with scene title (spaces converted to underscores, lowercased)
    studioSearchUrl: https://www.japanboyz.com/search.php?query={title}    
    spacesConvertTo: +
xPathScrapers:
  sceneScraper:
    scene:
      Title: //div[@class="movie-player"]/h2[@class="text-left"]
      Details:
        selector: //div[@class="description mt-3 mt-md-4"]/text()
        concat: " "
      Studio:
        Name:
          fixed: "Japan Boyz"
      Tags:
        Name:
          selector: //div[@class="v-tags mt-3 mt-md-4 text-center"]/a
          postProcess:
            - replace: 
                - regex: "#"
                  with: ""  
      Performers:
        Name:
          selector: //div[@class="m-info"]/div/a/text()
        URL: 
          selector: //div[@class="m-info"]/div/a/@href
      Image:
        selector: //meta[@property="og:image"]/@content
  performerScraper:
    performer:
      Name: //div[@class="model-info d-flex flex-column"]/h2[@class="text-left"]/text()
      URL:
        selector: //link[@rel="canonical"]/@content
        postProcess:
          - replace:
              - regex: "^http://"
                with: "https://"
      Gender:
        fixed: Male        
      Image: //img[@class="img-fluid"]/@src
      Country:
        fixed: Japan      
# Last Updated December 29, 2022
