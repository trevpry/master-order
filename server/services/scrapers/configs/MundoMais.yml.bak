name: "MundoMais"
sceneByURL:
  - action: scrapeXPath
    url:
      - mundomais.com.br/en/scene/
    scraper: sceneScraper
performerByName:
  - action: scrapeXPath
    queryURL: https://www.mundomais.com.br/en/models
    scraper: performerSearchScraper
sceneByFragment:
  - action: scrapeXPath
    performerSearchUrl: https://www.mundomais.com.br/en/models
    performerSearchScraper: performerSearchScraper
    studioSearchUrl: https://www.mundomais.com.br/en/scenes
    titleSearchScraper: sceneSearchScraper
    spacesConvertTo: " "
xPathScrapers:
  sceneScraper:
    scene:
      Title: //div[@class="barra-titulo p-2 p-sm-3 ps-xxl-5"]/h3/text()
      Details: 
        selector: //div[@class="descricao-video"]
          postProcess:
          - replace:
              - regex: "Description"
                with: ""
      Tags:
        Name: 
          selector: //div[@class="lista-tags"]/a/text()
          postProcess:
          - replace:
              - regex: "&nbsp;"
                with: " "
      Performers:
        Name:
          selector: //div[@class="ator-icone"]/a[@class="small text-center"]/text()
        URL:
          selector: //div[@class="ator-icone"]/a[@class="small text-center"]/@href
          postProcess:
          - replace:
              - regex: ^
                with: https://www.mundomais.com.br
      Date:
        selector : //div[@class="barra-titulo p-2 p-sm-3 ps-xxl-5"]/p/text()
        postProcess:
          - replace:
              - regex: "Published on "
                with: ""
          - parseDate: January 2, 2006
      Studio:
        Name:
          fixed: "MundoMais"
  sceneSearchScraper:
    pagination:
      maxPages: 30
      startPage: 1
      urlPattern: "{url}/page/{page}"
    scene:
      Title:
        selector: //article[contains(@class, "video-thumb-post")]//button[contains(@class, "accordion-button")]
        postProcess:
          - trim: true
      URL:
        selector: //article[contains(@class, "video-thumb-post")]//header/a/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.mundomais.com.br
  performerSearchScraper:
    performer:
      Name:
        selector: //div[@style="float:left"][@class="text-center"]/a[@class="small"]
        postProcess:
          - trim: true
      URL:
        selector: //div[@style="float:left"][@class="text-center"]/a[@class="small"]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.mundomais.com.br
      performerSceneScraper: performerPageScraper
  performerPageScraper:
    scene:
      Title:
        selector: //strong/text()
      URL:
        selector: //div[@class="col-lg-3 col-md-4 col-sm-6 mb-4"]/a/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.mundomais.com.br

# Last Updated November 13, 2025
