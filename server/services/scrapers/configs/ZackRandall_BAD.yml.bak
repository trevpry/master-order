name: "ZackRandall"
sceneByURL:
  - action: scrapeXPath
    url:
      - zackrandall.net/
      - www2.zackrandall.net/
    scraper: sceneScraper
sceneByName:
  - action: scrapeXPath
    titleSearchScraper: sceneSearchScraper
    performerSearchScraper: performerSearchScraper
    # Search for scenes by performers
    # {performer} will be replaced with performer name (spaces converted to underscores, lowercased)
    performerSearchUrl: https://www.zackrandall.net/zack-randall-search/{performer}/3?nats=My4yLjIyLjEyMC4wLjAuMC4wLjA
    # Search for scenes by title - direct scene URL
    # {title} will be replaced with scene title (spaces converted to plus signs, lowercased)
    studioSearchUrl: https://www.zackrandall.net/zack-randall-search/{title}?nats=My4yLjIyLjEyMC4wLjAuMC4wLjA
    spacesConvertTo: +
movieByURL:
  - action: scrapeXPath
    url:
      - zackrandall.net/zack-randall-watch/
    scraper: movieScraper
xPathScrapers:
  sceneScraper:
    scene:
      Title:
        selector: //h1/text()
        postProcess:
          - replace:
              - regex: ^(.+)\s\-\s(.+)$
                with: $2
      Details: //div[@class="videoContainer"]/p/text()
      Date:
        selector: //h1/text()
        postProcess:
          - replace:
              - regex: ^(.+)\s\-\s(.+)$
                with: $1
      URL: //link[@rel="canonical"]/@href
      Image:
        selector: //video/@poster
      Studio:
        Name: //a[@class="site-logo"]/img/@alt
      Performers:
        Name: //h2/a/text()
        URL:
          selector: //h2/a/@href
          postProcess:
            - replace:
                - regex: ^/
                  with: https://www.zackrandall.net
      Tags:
        Name:
          selector: //a[@class="btn btn-outline-primary mr-2"]/text()
  movieScraper:
    movie:
      Title: //div[@class="videoContainer"]/h1/text()
      Image: //video/@poster
      URL: //link[@rel="canonical"]/@href
      Performers:
        Name: //div[@class="videoContainer"]/h2/a/text()
        URL:
          selector: //div[@class="videoContainer"]/h2/a/@href
          postProcess:
            - replace:
                - regex: ^/
                  with: https://www.zackrandall.net
  sceneSearchScraper:
    # Search for scenes on a performer's page
    scene:
      Title: //a[@class="px-3 pt-3 pb-0 text-center d-block h110 text-truncate text-primary font-weight-bold"]/text()
      URL:
        selector: //a[@class="px-3 pt-3 pb-0 text-center d-block h110 text-truncate text-primary font-weight-bold"]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.zackrandall.net
      Image:
        selector: //div[@class="rounded embed-responsive embed-responsive-16by9"]/img/@src
  performerSearchScraper:
    # Search for performers - returns list of matching performers with URLs
    performer:
      Name: //div[@class="pb-1 m-2 text-center b-0 l-0 r-0 h6 text-truncate text-dark"]/text()
      URL:
        selector: //a[@class="mb-3 col-xxl-2 col-xl-3 col-md-3 col-sm-4 col-6 "]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.zackrandall.net
      Image:
        selector: //div[@class="rounded embed-responsive embed-responsive-16by9"]/img/@src
      performerSceneScraper: performerSceneScraper
  performerSceneScraper:
    # Extract scenes from a performer's detail page
    scene:
      Title: //a[@class="px-3 pt-3 pb-0 text-center d-block h110 text-truncate text-primary font-weight-bold"]/text()
      URL:
        selector: //a[@class="px-3 pt-3 pb-0 text-center d-block h110 text-truncate text-primary font-weight-bold"]/@href
        postProcess:
          - replace:
              - regex: ^
                with: https://www.zackrandall.net
      Performers:
        Name: //div[contains(@class, "text-terciary") and contains(@class, "text-truncate")]
        URL: //div[@class="mt-4"]//a[contains(@class, "h100")]/@href
